# ==============================================================================
# ReFlow Platform Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Web App: apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Optional: Supabase Service Role Key (for admin tasks & background workers)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 2. ReFlow Runner Daemon Configuration (Engine: packages/engine)
# ------------------------------------------------------------------------------
# Base URL of the ReFlow Web Control Plane (default: http://localhost:3000)
PORTALSYNC_CLOUD_URL=http://localhost:3000

# Organization Runner Bearer Token (format: ps_live_<org_id>)
PORTALSYNC_RUNNER_TOKEN=ps_live_your_org_id_here

# Local Chrome DevTools Protocol (CDP) Debugging Port (default: 9222)
PORTALSYNC_CDP_PORT=9222

# Directory where downloaded files and workflow artifacts are saved
# (default: ~/Downloads/PortalSync)
PORTALSYNC_TARGET_FOLDER=
