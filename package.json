{
  "name": "portalsync-saas",
  "version": "1.0.0",
  "private": true,
  "description": "PortalSync Enterprise B2B SaaS Monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --prefix apps/web",
    "build": "npm run build --prefix apps/web",
    "start": "npm run start --prefix apps/web",
    "runner": "node packages/engine/src/runner/cli.js",
    "runner:doctor": "node packages/engine/src/runner/cli.js doctor",
    "runner:listen": "node packages/engine/src/runner/cli.js listen",
    "desktop": "npm start --prefix apps/desktop",
    "desktop:build": "npm run build:win --prefix apps/desktop",
    "desktop:build:mac": "npm run build:mac --prefix apps/desktop",
    "desktop:build:all": "npm run build:all --prefix apps/desktop",
    "test": "node tests/run-all-tests.js"
  },
  "dependencies": {
    "puppeteer-core": "^25.12.0"
  }
}
