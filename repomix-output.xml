          }
        }
        // 2. Query artifacts from Supabase directly or via API endpoint
        let rawArtifacts: Array<Record<string, unknown>> = [];
        if (runIds.length > 0) {
          const { data: artifactsData, error: artError } = await supabase
            .from('wf_run_artifacts')
            .select('*')
