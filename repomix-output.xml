                for (const p of browserPages) {
                  if (p !== page && !p.isClosed()) {
                    const pUrl = p.url() || '';
                    const isDashboard = pUrl.includes('127.0.0.1:3000') || pUrl.includes('localhost:3000') || pUrl.includes('/app#');
                    if (!isDashboard) {
