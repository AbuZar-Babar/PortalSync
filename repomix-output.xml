        itemIndex: i,
        page: currentPage,
        label: itemIdentifier.itemLabel,
        itemKey: itemIdentifier.itemKey,
        status: 'SKIPPED_FILTER',
        skippedReason: filterCheck.reason,
        timestamp: new Date().toISOString()
